# Copy to /opt/demo/.env on the server. Never commit the real file.

DEMO_DOMAIN=api.rhaqim.com

# Images. CI pushes ghcr.io/<owner>/demo/<service>:<sha>; deploys pass TAG.
REGISTRY=ghcr.io/rhaqim/demo

# Bearer token for GET /api/feedback (reading feedback). Empty disables it.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional: Slack/Discord-style webhook that receives each new feedback.
FEEDBACK_WEBHOOK_URL=

# OpenAI models offered in the loom demo. Visitors bring their own keys.
OPENAI_MODELS=gpt-5-mini,gpt-5
