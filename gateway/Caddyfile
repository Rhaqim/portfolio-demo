# One gateway, two separate API hosts on this box:
#
#   api.rhaqim.com              the portfolio demos; pages on rhaqim.com
#   api.thebinaryhouse.studio   The Binary House demos (LaundryFlow); pages on
#                               thebinaryhouse.studio
#
# Each host has its own certificate, its own allowed origins and only its own
# routes, so neither site's pages can call the other's services.
#
# Cloudflare sits in front of both (proxied DNS, SSL mode "Full (strict)" in
# each zone). Caddy serves a Cloudflare Origin Certificate per host from
# /certs, so there is no ACME dance through the proxy, and browsers that reach
# the origin directly get a certificate they don't trust. See README.md,
# "Server setup".
{
	servers {
		# Caddy passes CF-Connecting-IP through untouched and the services rate
		# limit on it, which is only safe because the firewall admits nothing but
		# Cloudflare on 443.
		trusted_proxies static private_ranges
	}
}

# CORS for the pages allowed to call a host. {args[0]} is the origin regex.
(cors) {
	@cors_origin header_regexp Origin {args[0]}
	header @cors_origin {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Credentials "true"
		Vary "Origin"
	}
	@preflight {
		method OPTIONS
		header_regexp Origin {args[0]}
	}
	handle @preflight {
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-LLM-Key, X-LLM-Key-Anthropic, X-LLM-Key-OpenAI, X-LLM-Model, Last-Event-ID"
		header Access-Control-Max-Age "600"
		respond 204
	}
}

(hardening) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The loom demo and Studio send visitors' LLM keys in this header, and the
				# LaundryFlow demo its sandbox token in Authorization. Never log them.
				request>headers>X-Llm-Key delete
				request>headers>X-Llm-Key-Anthropic delete
				request>headers>X-Llm-Key-Openai delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

{$DEMO_DOMAIN:api.rhaqim.com} {
	tls /certs/origin.pem /certs/origin-key.pem
	import hardening
	import cors {$CORS_ORIGINS:^https://(www\.)?rhaqim\.com$}

	# Uploads get a little over buckt's 5 MB file cap; everything else is small.
	@upload path /api/buckt/files
	request_body @upload {
		max_size 6MB
	}
	@small not path /api/buckt/files
	request_body @small {
		max_size 128KB
	}

	handle /api/ussd/* {
		reverse_proxy ussd:8080
	}
	handle /api/buckt/* {
		reverse_proxy buckt:8080
	}
	handle /api/loom/* {
		# Agent runs and game rooms stream server-sent events; flush every
		# write, and let game streams stay open.
		reverse_proxy loom:8080 {
			flush_interval -1
		}
	}
	handle /api/studio/* {
		# Noewright Studio streams runs as server-sent events.
		reverse_proxy studio:8080 {
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy hub:8080
	}
	handle {
		respond "Not found" 404
	}
}

{$TBH_DOMAIN:api.thebinaryhouse.studio} {
	tls /certs/tbh-origin.pem /certs/tbh-origin-key.pem
	import hardening
	import cors {$TBH_CORS_ORIGINS:^https://(www\.)?thebinaryhouse\.studio$}

	request_body {
		max_size 16KB
	}

	handle /api/laundryflow/* {
		# Per-visitor sandboxes of the LaundryFlow engine, in memory. The page
		# is on another site, so it sends its sandbox token as Authorization
		# (dropped from the log above) rather than a cookie.
		reverse_proxy laundryflow:8080
	}
	handle {
		respond "Not found" 404
	}
}
